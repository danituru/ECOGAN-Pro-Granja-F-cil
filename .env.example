# Copia este archivo como .env.local (en local) o crea estas variables en Vercel.
# Sin las de Supabase, la web funciona en "modo pruebas" (no guarda nada).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: solo en el servidor. Nunca en el navegador ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# --- Correo (resend.com) ---
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, p. ej. "GranjaFácil <hola@tudominio.es>"
EMAIL_FROM=
# Dónde te llegan los avisos de cada reserva
EMAIL_OPERADOR=

# --- URL pública ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Más adelante (punto e: alta con pago) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRON_SECRET=
